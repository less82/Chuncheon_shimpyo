# 시민 앱 전용 — `vite --mode citizen` 일 때만 로드된다.
# 이 파일을 app/.env.citizen 으로 복사해 값을 채운다. app/.env.citizen 은 커밋하지 않는다.
#
# 주의: VITE_ 접두 값은 빌드 결과물에 그대로 박혀 브라우저에서 열어볼 수 있다.
# 공개돼도 감당 가능한 키만 여기 둔다. 과금되는 키(OpenRouter 등)는 .env.admin 에 둔다.

# 국토교통부 TAGO — 실시간 도착정보·버스위치. 없으면 실시간 표시가 꺼진다.
VITE_TAGO_KEY=

# 배포 전용 공개 설정.
VITE_PUBLIC_API_ORIGIN=https://api.shimpyo.chuncheon.go.kr
VITE_GEOCODING_API_ORIGIN=https://nominatim.openstreetmap.org

# maeng_coco 로컬 추론 API. 쓰지 않으면 비워 둔다.
VITE_MAENG_COCO_API_URL=http://127.0.0.1:8000
